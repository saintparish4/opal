---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  current?: "blog";
  rss?: boolean;
  noindex?: boolean;
  /** The history book adds its own typefaces to the site's two. */
  fonts?: string;
}
const {
  title,
  description,
  ogTitle,
  ogDescription,
  current,
  rss = false,
  noindex = false,
  fonts = "family=Archivo:wdth,wght@62..125,400..900&family=Martian+Mono:wdth,wght@75..112.5,400..700",
} = Astro.props;
const ogImage = new URL("/assets/opal-banner-light.jpg", Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  {description && <meta name="description" content={description}>}
  {noindex && <meta name="robots" content="noindex">}
  {ogTitle && <meta property="og:title" content={ogTitle}>}
  {ogDescription && <meta property="og:description" content={ogDescription}>}
  {ogTitle && <meta property="og:image" content={ogImage}>}
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0d0a0c" media="(prefers-color-scheme: dark)">
  <link rel="icon" href="/assets/favicon.ico" sizes="any">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`}>
  {rss && <link rel="alternate" type="application/rss+xml" title="Opal blog" href="/blog/rss.xml">}
  <link rel="stylesheet" href="/styles.css">
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <slot name="banner" />

  <Nav current={current} />

  <slot />

  <Footer />

  <slot name="scripts" />
  <script is:inline src="/nav.js"></script>
</body>
</html>
