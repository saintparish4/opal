---
interface Props {
  id: string;
  command: string;
}
const { id, command } = Astro.props;
---
<div class="slab">
  <code id={id}>{command}</code>
  <button class="copy" data-copy={id} aria-label="Copy the command" title="Copy">
    <svg class="icon-copy" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7m0 2.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667z"/><path d="M4.012 16.737a2.005 2.005 0 0 1 -1.012 -1.737v-10c0 -1.100 .9 -2 2 -2h10c.75 0 1.158 .385 1.500 1"/></svg>
    <svg class="icon-done" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5l10 -10"/></svg>
  </button>
</div>
