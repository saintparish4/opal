# Auto-detect text files and normalize line endings to LF.
# Contributors build on macOS, Linux, and WSL2 (and Windows itself in v2),
# so this keeps the tree consistent regardless of platform checkout settings.
* text=auto eol=lf

# --- Rust ---
*.rs        text eol=lf diff=rust
Cargo.toml  text eol=lf
Cargo.lock  text eol=lf linguist-generated

# --- Config / data ---
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf diff=markdown

# --- Scripts ---
*.sh   text eol=lf
*.ps1  text eol=crlf

# --- Windows-specific sources (v2 native target) ---
*.bat  text eol=crlf
*.cmd  text eol=crlf

# --- Binary / release artifacts: never diff, never normalize ---
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ico    binary
*.gz     binary
*.tar    binary
*.zip    binary
*.exe    binary
*.dll    binary
*.so     binary
*.dylib  binary

# --- npm-compatibility fixtures (per build_guide.md §4 test strategy) ---
# Real-world package fixtures checked in for the compat suite shouldn't
# pollute language stats or diffs.
tests/fixtures/**  linguist-vendored
node_modules/**    -diff linguist-vendored

# --- Repo-internal planning docs: keep out of source archives ---
base/**          export-ignore
.gitattributes   export-ignore
.gitignore       export-ignore
